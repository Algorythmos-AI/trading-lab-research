[Unit]
Description=Cloudflare tunnel for admin SSH (outbound only; no inbound port is ever opened)
Wants=network-online.target wt-secrets.service
After=network-online.target wt-secrets.service
ConditionPathExists=/etc/cloudflared/token

[Service]
User=cloudflared
Group=cloudflared
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
