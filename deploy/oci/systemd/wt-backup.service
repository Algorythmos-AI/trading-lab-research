[Unit]
Description=Trading Lab: verify the evidence chains, back up to R2, anchor today's heads
Wants=wt-secrets.service network-online.target
After=wt-secrets.service network-online.target
OnFailure=wt-alert@%n.service

[Service]
Type=exec
User=wt
Group=wt
WorkingDirectory=/home/wt/trading
EnvironmentFile=/run/wt-secrets/env
Environment=WT_ENV_FILE=/run/wt-secrets/env
Environment=WT_HOST=systemd
Environment=PYTHONPATH=src
ExecStart=/home/wt/trading/.venv/bin/python -m wt.ops.backup nightly
RuntimeMaxSec=7200
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
