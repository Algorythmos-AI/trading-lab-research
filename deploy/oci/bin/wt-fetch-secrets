#!/usr/bin/env bash
# Root, once per boot (wt-secrets.service): read the trading host's secrets and write them where the jobs read them.
# Never prints a value. Two sources, chosen by /etc/wt/secrets-source (written at first boot):
#   oci-vault (default)  OCI Vault through the instance principal (docs/runbooks/oci-host.md)
#   file                 /etc/wt/secrets.env, root 0600, filled by the owner with wt-set-secrets (hosts without a
#                        vault, e.g. the GCP free-tier e2-micro; docs/runbooks/gcp-host.md)
#   /run/wt-secrets/env    KEY=VALUE for the jobs (tmpfs, wt:wt 0400; gone at shutdown)
#   /etc/wt/paging         NTFY_TOPIC and HC_PING_KEY (root:wt 0640, on disk: paging works even if the source is down)
#   /etc/cloudflared/token the tunnel token (cloudflared 0400), when the source has one
# Secret names are the variable names below. On OCI the vault's OCID comes from instance metadata.
set -euo pipefail
umask 077

REQUIRED=(APCA_API_KEY_ID APCA_API_SECRET_KEY DASHBOARD_INGEST_URL DASHBOARD_INGEST_SECRET
          VERCEL_AUTOMATION_BYPASS_SECRET NTFY_TOPIC)
OPTIONAL=(HC_PING_KEY WT_HOST_ID WT_ROLE DASHBOARD_KEY_ID R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY RESTIC_PASSWORD
          RESTIC_REPOSITORY CLOUDFLARED_TOKEN NTFY_SERVER GH_TOKEN APCA_OPTIONS_KEY_ID APCA_OPTIONS_SECRET_KEY)
OCI=/usr/local/bin/oci
SECRETS_FILE=/etc/wt/secrets.env
# A primary trades: it needs the lease and the backups (on R2, with restic) and its dead-man pings. A shadow may not.
PRIMARY_REQUIRED=(R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY RESTIC_REPOSITORY RESTIC_PASSWORD HC_PING_KEY)
source_kind=$(cat /etc/wt/secrets-source 2>/dev/null || echo oci-vault)

if [[ "$source_kind" == file ]]; then
  [[ -r "$SECRETS_FILE" ]] || { echo "wt-fetch-secrets: $SECRETS_FILE not written yet (run: sudo wt-set-secrets)" >&2; exit 1; }
  fetch() {   # prints the value, or nothing if the name isn't in the file
    local line
    line=$(grep -m1 -E "^$1=" "$SECRETS_FILE" || true)
    printf '%s' "${line#*=}"
  }
else
  meta() { curl -fsS --max-time 5 -H "Authorization: Bearer Oracle" "http://169.254.169.254/opc/v2/instance/$1"; }
  vault_id=$(meta metadata/wt_vault_id)
  [[ "$vault_id" == ocid1.vault.* ]] || { echo "wt-fetch-secrets: no vault id in instance metadata" >&2; exit 1; }
  fetch() {   # prints the decoded value, or nothing if the secret doesn't exist
    "$OCI" secrets secret-bundle get-secret-bundle-by-name --auth instance_principal --vault-id "$vault_id" \
      --secret-name "$1" --query 'data."secret-bundle-content".content' --raw-output 2>/dev/null | base64 -d
  }
fi

install -d -m 0750 -o root -g wt /run/wt-secrets /etc/wt
tmp=$(mktemp /run/wt-secrets/.env.XXXXXX)
trap 'rm -f "$tmp"' EXIT
missing=()
for name in "${REQUIRED[@]}" "${OPTIONAL[@]}"; do
  value=$(fetch "$name" || true)
  if [[ -z "$value" ]]; then
    for r in "${REQUIRED[@]}"; do [[ "$r" == "$name" ]] && missing+=("$name"); done
    continue
  fi
  case "$name" in
    CLOUDFLARED_TOKEN)
      install -d -m 0750 -o root -g cloudflared /etc/cloudflared
      printf '%s' "$value" > /etc/cloudflared/token
      chown cloudflared:cloudflared /etc/cloudflared/token && chmod 0400 /etc/cloudflared/token ;;
    *)
      [[ "$value" == *$'\n'* ]] && { echo "wt-fetch-secrets: $name spans lines; skipped" >&2; continue; }
      printf '%s=%s\n' "$name" "$value" >> "$tmp" ;;
  esac
done
role=$(grep -m1 -E '^WT_ROLE=' "$tmp" | cut -d= -f2- || true)
if [[ "${role:-primary}" == primary ]]; then
  for r in "${PRIMARY_REQUIRED[@]}"; do grep -q -E "^$r=" "$tmp" || missing+=("$r (primary)"); done
fi
if (( ${#missing[@]} )); then
  echo "wt-fetch-secrets: required secrets missing from $source_kind: ${missing[*]}" >&2
  exit 1                       # the unit fails, the timer retries in 10 minutes, the job units won't start
fi
chown wt:wt "$tmp" && chmod 0400 "$tmp" && mv -f "$tmp" /run/wt-secrets/env
trap - EXIT
# The paging file survives a secrets-source outage after reboot (wt-alert reads it).
page=$(mktemp /etc/wt/.paging.XXXXXX)
grep -E '^(NTFY_TOPIC|NTFY_SERVER|HC_PING_KEY)=' /run/wt-secrets/env > "$page" || true
chown root:wt "$page" && chmod 0640 "$page" && mv -f "$page" /etc/wt/paging
echo "wt-fetch-secrets: $(wc -l < /run/wt-secrets/env | tr -d ' ') values written"
