#!/usr/bin/env bash
# Root, once per boot (wt-secrets.service): read the trading host's secrets from OCI Vault with the instance
# principal and write them where the jobs read them. Never prints a value.
#   /run/wt-secrets/env    KEY=VALUE for the jobs (tmpfs, wt:wt 0400; gone at shutdown)
#   /etc/wt/paging         NTFY_TOPIC and HC_PING_KEY (root:wt 0640, on disk: paging works even if Vault is down)
#   /etc/cloudflared/token the tunnel token (cloudflared 0400), when present in the vault
# Secret names in the vault are the variable names below. The vault's OCID comes from instance metadata.
set -euo pipefail
umask 077

REQUIRED=(APCA_API_KEY_ID APCA_API_SECRET_KEY DASHBOARD_INGEST_URL DASHBOARD_INGEST_SECRET
          VERCEL_AUTOMATION_BYPASS_SECRET NTFY_TOPIC)
OPTIONAL=(HC_PING_KEY WT_HOST_ID WT_ROLE R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY RESTIC_PASSWORD
          RESTIC_REPOSITORY CLOUDFLARED_TOKEN)
OCI=/usr/local/bin/oci

meta() { curl -fsS --max-time 5 -H "Authorization: Bearer Oracle" "http://169.254.169.254/opc/v2/instance/$1"; }
vault_id=$(meta metadata/wt_vault_id)
[[ "$vault_id" == ocid1.vault.* ]] || { echo "wt-fetch-secrets: no vault id in instance metadata" >&2; exit 1; }

fetch() {   # prints the decoded value, or nothing if the secret doesn't exist
  "$OCI" secrets secret-bundle get-secret-bundle-by-name --auth instance_principal --vault-id "$vault_id" \
    --secret-name "$1" --query 'data."secret-bundle-content".content' --raw-output 2>/dev/null | base64 -d
}

install -d -m 0750 -o root -g wt /run/wt-secrets /etc/wt
tmp=$(mktemp /run/wt-secrets/.env.XXXXXX)
trap 'rm -f "$tmp"' EXIT
missing=()
for name in "${REQUIRED[@]}" "${OPTIONAL[@]}"; do
  value=$(fetch "$name" || true)
  if [[ -z "$value" ]]; then
    for r in "${REQUIRED[@]}"; do [[ "$r" == "$name" ]] && missing+=("$name"); done
    continue
  fi
  case "$name" in
    CLOUDFLARED_TOKEN)
      install -d -m 0750 -o root -g cloudflared /etc/cloudflared
      printf '%s' "$value" > /etc/cloudflared/token
      chown cloudflared:cloudflared /etc/cloudflared/token && chmod 0400 /etc/cloudflared/token ;;
    *)
      [[ "$value" == *$'\n'* ]] && { echo "wt-fetch-secrets: $name spans lines; skipped" >&2; continue; }
      printf '%s=%s\n' "$name" "$value" >> "$tmp" ;;
  esac
done
if (( ${#missing[@]} )); then
  echo "wt-fetch-secrets: required secrets missing from the vault: ${missing[*]}" >&2
  exit 1                       # the unit fails, the timer retries in 10 minutes, the job units won't start
fi
chown wt:wt "$tmp" && chmod 0400 "$tmp" && mv -f "$tmp" /run/wt-secrets/env
trap - EXIT
# The paging file survives a Vault outage after reboot (wt-alert reads it).
page=$(mktemp /etc/wt/.paging.XXXXXX)
grep -E '^(NTFY_TOPIC|NTFY_SERVER|HC_PING_KEY)=' /run/wt-secrets/env > "$page" || true
chown root:wt "$page" && chmod 0640 "$page" && mv -f "$page" /etc/wt/paging
echo "wt-fetch-secrets: $(wc -l < /run/wt-secrets/env | tr -d ' ') values written"
