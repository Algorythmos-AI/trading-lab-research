#!/usr/bin/env bash
# Root, run by the owner in an SSH session on a host whose secrets come from a file (/etc/wt/secrets-source = file):
#   sudo wt-set-secrets
# Prompts for every value the host reads (secrets are hidden while typed and never printed), writes
# /etc/wt/secrets.env (root 0600) atomically, then re-runs wt-secrets so the jobs see the new values.
# Enter keeps the value already in the file (or the default shown); optional values may be left empty.
set -euo pipefail
umask 077
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 1; }
FILE=/etc/wt/secrets.env

# name|default|hidden|required
FIELDS=(
  "WT_ROLE|shadow|0|1"
  "WT_HOST_ID|gcp-use1|0|1"
  "DASHBOARD_KEY_ID|gcp-use1|0|1"
  "DASHBOARD_INGEST_URL||0|1"
  "DASHBOARD_INGEST_SECRET||1|1"
  "VERCEL_AUTOMATION_BYPASS_SECRET||1|1"
  "APCA_API_KEY_ID||1|1"
  "APCA_API_SECRET_KEY||1|1"
  "NTFY_TOPIC||1|1"
  "HC_PING_KEY||1|0"
  "R2_ACCOUNT_ID||1|0"
  "R2_ACCESS_KEY_ID||1|0"
  "R2_SECRET_ACCESS_KEY||1|0"
  "RESTIC_REPOSITORY||1|0"
  "RESTIC_PASSWORD||1|0"
  "CLOUDFLARED_TOKEN||1|0"
  "NTFY_SERVER||0|0"
  "GH_TOKEN||1|0"
)
# Values in the file that no field above names are kept as they are (never dropped by a re-run).

current() { if [[ -r "$FILE" ]]; then grep -m1 -E "^$1=" "$FILE" | cut -d= -f2- || true; fi; }

install -d -m 0750 -o root -g wt /etc/wt
tmp=$(mktemp /etc/wt/.secrets.XXXXXX)
trap 'rm -f "$tmp"' EXIT
for f in "${FIELDS[@]}"; do
  IFS='|' read -r name default hidden required <<< "$f"
  have=$(current "$name")
  [[ -z "$have" ]] && have="$default"
  hint=""
  if [[ -n "$have" && "$hidden" == 1 ]]; then hint=" [Enter keeps the current value]"; fi
  if [[ -n "$have" && "$hidden" == 0 ]]; then hint=" [Enter keeps: $have]"; fi
  [[ "$required" == 0 ]] && hint="$hint (optional)"
  while :; do
    if [[ "$hidden" == 1 ]]; then read -rsp "$name$hint: " value; echo; else read -rp "$name$hint: " value; fi
    value="${value#"${value%%[![:space:]]*}"}"; value="${value%"${value##*[![:space:]]}"}"   # trim pasted spaces
    [[ -z "$value" ]] && value="$have"
    [[ -z "$value" && "$required" == 1 ]] && { echo "  $name is required."; continue; }
    break
  done
  if [[ -n "$value" ]]; then printf '%s=%s\n' "$name" "$value" >> "$tmp"; fi
done
if [[ -r "$FILE" ]]; then
  names=$(for f in "${FIELDS[@]}"; do printf '%s\n' "${f%%|*}"; done)
  grep -v -E "^($(paste -sd'|' <<< "$names"))=" "$FILE" | grep -E '^[A-Z_][A-Z0-9_]*=' >> "$tmp" || true
fi
chown root:root "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$FILE"
trap - EXIT
echo "wrote $FILE ($(wc -l < "$FILE" | tr -d ' ') values, not shown); re-running wt-secrets"
if systemctl restart wt-secrets.service; then
  echo "wt-secrets: ok"
else
  echo "wt-secrets failed (values not shown):"; journalctl -u wt-secrets.service -n 5 --no-pager; exit 1
fi
