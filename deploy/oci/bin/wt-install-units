#!/usr/bin/env bash
# OWNER ONLY (sudo): install the job units rendered from the code and enable their timers. Refuses while the
# deploy gate is closed (a job running, inside the trading window, or within an hour of a start).
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 2; }
root=/home/wt/trading
as_wt() { runuser -u wt -- env WT_HOST=systemd WT_ENV_FILE=/run/wt-secrets/env PYTHONPATH=src "$@"; }
cd "$root"
as_wt make -s gate PY=.venv/bin/python || { echo "deploy gate closed: not installing units now" >&2; exit 2; }
as_wt .venv/bin/python -m wt.ops.units render --out var/units --root "$root"
install -m 0644 var/units/wt-*.service var/units/wt-*.timer /etc/systemd/system/
systemctl daemon-reload
for t in var/units/wt-*.timer; do systemctl enable --now "$(basename "$t")"; done
systemctl list-timers 'wt-*' --no-pager
