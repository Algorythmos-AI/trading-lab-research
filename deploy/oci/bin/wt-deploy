#!/usr/bin/env bash
# The only command Claude's deploy key can run on the host (authorized_keys: restrict,command="…/wt-deploy").
# Runs as the job user, never with sudo. Everything goes through the same gate as the Mac.
set -euo pipefail
cmd="${SSH_ORIGINAL_COMMAND:-${*:-}}"
cd /home/wt/trading
export WT_HOST=systemd WT_ENV_FILE=/run/wt-secrets/env PYTHONPATH=src
if [[ -r "$WT_ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "$WT_ENV_FILE"
  set +a
fi
case "$cmd" in
  gate|status|preflight)
    exec make -s "$cmd" PY=.venv/bin/python ;;
  units-diff)
    exec .venv/bin/python -m wt.ops.units diff --root /home/wt/trading ;;
  deploy)
    make -s deploy PY=.venv/bin/python
    # The full suite on this ARM64 host is the platform check CI can't do. On failure, go back.
    if ! .venv/bin/python -m pytest -q -p no:cacheprovider; then
      latest=""
      for f in var/deploy/*.json; do [[ -e "$f" ]] && latest="$f"; done     # names are timestamps: last is newest
      tag=""
      [[ -n "$latest" ]] && tag=$(jq -r '.rollback_tag // empty' "$latest")
      echo "wt-deploy: the test suite FAILED on this host; rolling back to ${tag:-?}" >&2
      [[ -n "$tag" ]] && make -s rollback TAG="$tag" PY=.venv/bin/python
      exit 1
    fi
    .venv/bin/python -m wt.ops.units render --out var/units --root /home/wt/trading >/dev/null
    .venv/bin/python -m wt.ops.units diff --root /home/wt/trading || echo "wt-deploy: units changed; the owner runs: sudo wt-install-units"
    ;;
  rollback\ runtime-*)
    tag="${cmd#rollback }"
    [[ "$tag" =~ ^runtime-[A-Za-z0-9._-]+$ ]] || { echo "wt-deploy: bad tag" >&2; exit 2; }
    exec make -s rollback TAG="$tag" PY=.venv/bin/python ;;
  *)
    echo "wt-deploy: allowed: gate | status | preflight | deploy | units-diff | rollback runtime-<tag>" >&2
    exit 2 ;;
esac
