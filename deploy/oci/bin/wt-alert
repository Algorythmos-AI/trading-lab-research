#!/usr/bin/env bash
# Page the owner that a unit failed (wt-alert@<unit>.service, OnFailure=). Reads only /etc/wt/paging, so it works
# when the secrets fetch is what failed. Never fails its caller.
set -uo pipefail
unit="${1:-a unit}"
topic=""
server="https://ntfy.sh"
if [[ -r /etc/wt/paging ]]; then
  topic=$(sed -n 's/^NTFY_TOPIC=//p' /etc/wt/paging | head -1)
  s=$(sed -n 's/^NTFY_SERVER=//p' /etc/wt/paging | head -1); [[ -n "$s" ]] && server="$s"
fi
if [[ -z "$topic" ]]; then
  echo "wt-alert: no ntfy topic configured; $unit failed" >&2
  exit 0
fi
prio=4; [[ "$unit" == wt-paper-b* ]] && prio=5
curl -fsS --max-time 10 -H "Title: Trading host: ${unit%.service} failed" -H "Priority: $prio" \
  -d "systemd reports ${unit} failed on $(hostname -s). Check: journalctl -u ${unit} and make status." \
  "${server%/}/${topic}" >/dev/null || echo "wt-alert: ntfy unreachable; $unit failed" >&2
exit 0
