#!/usr/bin/env bash
# Root, run by the owner in an SSH session (ADR 0011):
#   sudo wt-set-webull-secret
# Puts the Webull Australia OpenAPI key on this host for the read-only pull job, and nowhere else:
#   * creates the system user wt-webull (group wt, no login shell, no home) if it is missing;
#   * prompts for the App Key and App Secret (hidden while typed, never printed) and writes /etc/wt/webull.env,
#     root 0600, atomically. systemd hands it to wt-webull-pull.service alone as a credential; it is not part of
#     /etc/wt/secrets.env or /run/wt-secrets/env, so no wt job can read it;
#   * forgets any stored token, because a new secret makes the old token useless;
#   * checks that wt-webull can load the read-only client from the checkout.
# It starts nothing. Enable the timer with `sudo wt-install-units`, then run the job once by hand (runbook).
set -euo pipefail
umask 077
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 1; }
FILE=/etc/wt/webull.env
root=/home/wt/trading

if ! id -u wt-webull >/dev/null 2>&1; then
  useradd --system --gid wt --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin wt-webull
  echo "created the system user wt-webull"
fi

install -d -m 0750 -o root -g wt /etc/wt
read_hidden() {
  local v
  while :; do
    read -rsp "$1: " v; echo >&2
    v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"     # trim pasted spaces
    [[ "$v" =~ ^[A-Za-z0-9._-]{8,200}$ ]] && { printf '%s' "$v"; return; }
    echo "  that does not look like a Webull key value (letters, digits, . _ - only); try again" >&2
  done
}
key=$(read_hidden "WEBULL_APP_KEY (App Key)")
secret=$(read_hidden "WEBULL_APP_SECRET (App Secret, after Reset Key)")

tmp=$(mktemp /etc/wt/.webull.XXXXXX)
trap 'rm -f "$tmp"' EXIT
printf 'WEBULL_APP_KEY=%s\nWEBULL_APP_SECRET=%s\n' "$key" "$secret" > "$tmp"
unset key secret
chown root:root "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$FILE"
trap - EXIT
rm -f /var/lib/wt-webull/token.json
echo "wrote $FILE (2 values, not shown); any old token forgotten"

if runuser -u wt-webull -- env PYTHONPATH="$root/src" PYTHONDONTWRITEBYTECODE=1 \
     "$root/.venv/bin/python" -c 'import wt.webull.pull' 2>/dev/null; then
  echo "wt-webull can load the read-only client: ok"
else
  echo "wt-webull cannot load $root/.venv or $root/src (permissions?). See docs/runbooks/webull-readonly.md" >&2
  exit 1
fi
echo "next: sudo wt-install-units (after the close), then: sudo systemctl start wt-webull-pull.service"
