# Copy to .env (mode 600) and fill in. Never commit .env. Values are read by wt.core.config.

# --- Market data and the PAPER account (Alpaca). Paper access is hard-coded in the broker adapter. ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# A second PAPER account, for option trades placed by hand. Read only: wt.options.live shows its open option
# positions on the Options desk. Empty = that job does nothing.
APCA_OPTIONS_KEY_ID=
APCA_OPTIONS_SECRET_KEY=
# Optional: a PAPER account of the options clone's own (DEC-0030). When set, the clone (job paper-o) trades there;
# when empty, it trades in the second account above, beside the owner's hand trades.
APCA_CLONE_KEY_ID=
APCA_CLONE_SECRET_KEY=

# --- Mode flags. The nightly jobs set MODE themselves (paper for paper-b, backtest otherwise). ---
# Live trading is never enabled from this repo; LIVE_TRADING_ENABLED is the owner's switch and stays false.
MODE=backtest
LIVE_TRADING_ENABLED=false

# --- Runtime state directory (default: <repo>/var). ---
# WT_STATE=

# --- Phone alerts (ntfy). A secret random topic; messages carry R and % only. ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- The Calendar page's release dates (wt.ops.econ_calendar). Both optional. A free FRED key from
# fred.stlouisfed.org/docs/api/api_key.html; without it BLS and BEA stand in. BLS answers only a caller that leaves a
# contact address in its user agent: without one BLS is not asked.
FRED_API_KEY=
WT_CONTACT_EMAIL=

# --- Webull: no key here. It lives on the host only, written by `sudo wt-set-webull-secret` (ADR 0011). ---

# OCI host (ADR 0004): the Access SSH hostname and the Access service token Claude's deploys use.
VM_SSH_HOST=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# healthchecks.io ping key (docs/runbooks/dead-man-switches.md). Empty = no pings.
HC_PING_KEY=
# Which host this is, in pings and snapshots (defaults to the hostname) and its role (primary | shadow).
WT_HOST_ID=
WT_ROLE=primary
# This host's dashboard key id (the OCI host signs with its own key; the dashboard's PRIMARY_HOST decides
# whose snapshot is live). Empty on the Mac = "default" (DASHBOARD_INGEST_SECRET).
DASHBOARD_KEY_ID=
