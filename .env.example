# The Mac console checkout's .env: copy to .env (mode 600) and fill in. Never commit .env. Read by wt.core.config.
# The jobs run on the GCP host, whose secrets are set with `sudo wt-set-secrets` (docs/runbooks/gcp-host.md), not here.
# Every variable the code reads, and where each is set: docs/reference/env-vars.md.

# --- Market data and the PAPER account (Alpaca). Paper access is hard-coded in the broker adapter. ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# LEGACY: a second PAPER account, once for option trades placed by hand. docs/runbooks/paper-accounts.md says the
# account was deleted; leave it empty. The code still reads it: wt.options.live for positions, and the clone as a
# fallback when APCA_CLONE_* is empty.
APCA_OPTIONS_KEY_ID=
APCA_OPTIONS_SECRET_KEY=
# The options clone's PAPER account, "Clone options" (DEC-0030; job paper-o). On the host, not on the Mac.
APCA_CLONE_KEY_ID=
APCA_CLONE_SECRET_KEY=
# The PAPER account of Gap Hunter, the stock desk (DEC-0066; job paper-s). Its own account, never
# a fallback to the first pair: the runner refuses to start without both (it reads no other pair).
APCA_S_KEY_ID=
APCA_S_SECRET_KEY=

# --- Mode flags. The nightly jobs set MODE themselves (paper for the paper runners, backtest otherwise). ---
# Live trading is never enabled from this repo; LIVE_TRADING_ENABLED is the owner's switch and stays false.
MODE=backtest
LIVE_TRADING_ENABLED=false

# --- Runtime state directory (default: <repo>/var). ---
# WT_STATE=

# --- Phone alerts (ntfy). A secret random topic; messages carry R and % only. ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- The Calendar page's release dates (wt.ops.econ_calendar). Both optional. A free FRED key from
# fred.stlouisfed.org/docs/api/api_key.html; without it BLS and BEA stand in. BLS answers only a caller that leaves a
# contact address in its user agent: without one BLS is not asked.
FRED_API_KEY=
WT_CONTACT_EMAIL=

# --- Webull: no key here. It lives on the host only, written by `sudo wt-set-webull-secret` (ADR 0011). ---

# `make vm-deploy` only: the old Cloudflare-Access route to a host (ADR 0004). The GCP host is reached with
# `gcloud compute ssh --tunnel-through-iap` instead (docs/runbooks/gcp-host.md).
VM_SSH_HOST=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# healthchecks.io ping key (docs/runbooks/dead-man-switches.md). Empty = no pings.
HC_PING_KEY=
# Which host this is, in pings and snapshots (defaults to the hostname) and its role (primary | shadow).
WT_HOST_ID=
WT_ROLE=primary
# This host's dashboard key id (a host signs with its own key; the dashboard's PRIMARY_HOST decides
# whose snapshot is live). Empty on the Mac = "default" (DASHBOARD_INGEST_SECRET).
DASHBOARD_KEY_ID=
