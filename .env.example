# Copy to .env (mode 600) and fill in. Never commit .env. Values are read by wt.core.config.

# --- Market data and the PAPER account (Alpaca). Paper access is hard-coded in the broker adapter. ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Mode flags. The nightly jobs set MODE themselves (paper for paper-b, backtest otherwise). ---
# Live trading is never enabled from this repo; LIVE_TRADING_ENABLED is the owner's switch and stays false.
MODE=backtest
LIVE_TRADING_ENABLED=false

# --- Runtime state directory (default: <repo>/var). ---
# WT_STATE=

# --- Phone alerts (ntfy). A secret random topic; messages carry R and % only. ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Webull (execution adapter, not used yet). Keys from webull.com.au > API Keys Management. ---
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_APP_ID=
WEBULL_REGION=au

# OCI host (ADR 0004): the Access SSH hostname and the Access service token Claude's deploys use.
VM_SSH_HOST=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# healthchecks.io ping key (docs/runbooks/dead-man-switches.md). Empty = no pings.
HC_PING_KEY=
# Which host this is, in pings and snapshots (defaults to the hostname) and its role (primary | shadow).
WT_HOST_ID=
WT_ROLE=primary
