{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WarriorTradingStrategyConfigV2",
  "type": "object",
  "properties": {
    "selection_funnel_pipeline": {
      "type": "object",
      "description": "3-Tier Selection Funnel for ranking scanner results down to a primary execution candidate.",
      "properties": {
        "tier_1_scanner_pool": {
          "type": "object",
          "properties": {
            "max_candidates": {
              "type": "integer",
              "default": 20
            },
            "filtering_method": "quantitative_scanner_filters"
          }
        },
        "tier_2_qualified_watchlist": {
          "type": "object",
          "properties": {
            "max_candidates": {
              "type": "integer",
              "default": 4
            },
            "target_range": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "example": [
                2,
                4
              ]
            },
            "filtering_method": "qualitative_catalyst_and_daily_chart_screening"
          }
        },
        "tier_3_primary_focus": {
          "type": "object",
          "properties": {
            "max_candidates": {
              "type": "integer",
              "default": 1
            },
            "purpose": "pre_staged_order_execution_for_market_open"
          }
        },
        "scoring_weights": {
          "type": "object",
          "properties": {
            "gap_percentage_weight": {
              "type": "number",
              "default": 0.25
            },
            "relative_volume_weight": {
              "type": "number",
              "default": 0.25
            },
            "low_float_weight": {
              "type": "number",
              "default": 0.2
            },
            "catalyst_quality_weight": {
              "type": "number",
              "default": 0.15
            },
            "former_runner_bonus_weight": {
              "type": "number",
              "default": 0.15
            }
          }
        }
      }
    },
    "scanners": {
      "type": "object",
      "properties": {
        "pre_market_gap_scanner": {
          "type": "object",
          "properties": {
            "price_range_usd": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "example": [
                1.0,
                20.0
              ]
            },
            "preferred_price_range_usd": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "example": [
                1.5,
                10.0
              ]
            },
            "min_gap_percentage": {
              "type": "number",
              "default": 4.0
            },
            "preferred_gap_percentage": {
              "type": "number",
              "default": 20.0
            },
            "max_float_shares": {
              "type": "number",
              "default": 50000000
            },
            "preferred_float_shares": {
              "type": "number",
              "default": 20000000
            },
            "min_premarket_volume": {
              "type": "number",
              "default": 50000
            },
            "tradeable_premarket_volume": {
              "type": "number",
              "default": 500000
            },
            "min_relative_volume": {
              "type": "number",
              "default": 2.0
            },
            "preferred_relative_volume": {
              "type": "number",
              "default": 5.0
            },
            "required_catalyst_types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "enum": [
                "earnings_release",
                "fda_approval",
                "clinical_study_results",
                "price_target_upgrade",
                "breaking_news"
              ]
            },
            "excluded_catalyst_types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "enum": [
                "buyout_offer",
                "unconfirmed_rumor"
              ]
            }
          },
          "required": [
            "min_gap_percentage",
            "max_float_shares",
            "min_relative_volume",
            "required_catalyst_types"
          ]
        },
        "high_of_day_momentum_scanner": {
          "type": "object",
          "properties": {
            "price_range_usd": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "example": [
                1.0,
                10.0
              ]
            },
            "min_volume_today": {
              "type": "number",
              "default": 100000
            },
            "active_trading_volume_today": {
              "type": "number",
              "default": 1000000
            },
            "min_relative_volume": {
              "type": "number",
              "default": 2.0
            },
            "min_5min_volume_surge_pct": {
              "type": "number",
              "default": 2000.0
            },
            "max_float_shares": {
              "type": "number",
              "default": 20000000
            },
            "max_bid_ask_spread_usd": {
              "type": "number",
              "default": 0.05
            }
          }
        },
        "reversal_hybrid_scanner": {
          "type": "object",
          "properties": {
            "price_range_usd": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "example": [
                15.0,
                250.0
              ]
            },
            "min_volume_today": {
              "type": "number",
              "default": 500000
            },
            "min_avg_daily_volume_5d": {
              "type": "number",
              "default": 300000
            },
            "min_relative_volume": {
              "type": "number",
              "default": 1.0
            },
            "min_consecutive_5min_candles": {
              "type": "integer",
              "default": 3
            },
            "bollinger_band_std_dev": {
              "type": "number",
              "default": 2.0
            },
            "rsi_oversold_threshold": {
              "type": "number",
              "default": 20.0
            },
            "rsi_overbought_threshold": {
              "type": "number",
              "default": 80.0
            },
            "min_ema9_distance_usd": {
              "type": "number",
              "default": 0.3
            }
          }
        }
      }
    },
    "technical_filters": {
      "type": "object",
      "properties": {
        "required_above_daily_emas": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            20,
            50,
            200
          ]
        },
        "window_height_must_exceed_atr14": {
          "type": "boolean",
          "default": true
        },
        "former_runner_history_required": {
          "type": "boolean",
          "default": false,
          "description": "Soft validator/scoring booster rather than a hard binary rejection."
        }
      }
    },
    "execution_rules": {
      "type": "object",
      "properties": {
        "min_risk_reward_ratio": {
          "type": "number",
          "default": 2.0
        },
        "max_trade_duration_minutes": {
          "type": "integer",
          "default": 5
        },
        "allow_averaging_down": {
          "type": "boolean",
          "default": false
        },
        "partial_profit_take_pct": {
          "type": "number",
          "default": 50.0
        }
      }
    }
  }
}