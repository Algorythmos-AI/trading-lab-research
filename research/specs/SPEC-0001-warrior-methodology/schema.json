{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SPEC-0001/schema.json",
  "title": "SPEC-0001 normalised methodology spec (extends the owner's schema v2)",
  "type": "object",
  "required": ["spec_id", "title", "version", "status", "direction", "sources", "candidate_pool", "scanners",
               "funnel", "former_runner", "chart_filters", "patterns", "entries", "execution", "exits", "risk",
               "tape", "routine", "evaluation", "not_implementable"],
  "additionalProperties": false,
  "definitions": {
    "hhmm": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "window": {"type": "array", "items": {"$ref": "#/definitions/hhmm"}, "minItems": 2, "maxItems": 2},
    "range": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "pos": {"type": "number", "exclusiveMinimum": 0},
    "catalyst": {"type": "string", "enum": ["earnings_release", "fda_approval", "clinical_study_results",
      "price_target_upgrade", "breaking_news", "buyout_offer", "unconfirmed_rumor", "offering_dilution",
      "reverse_split", "hype_only", "none"]},
    "entry": {"type": "object", "required": ["name", "attempts"],
      "properties": {"name": {"type": "string"}, "attempts": {"type": "integer", "minimum": 1, "maximum": 2},
                     "window": {"$ref": "#/definitions/window"}}}
  },
  "properties": {
    "spec_id": {"type": "string", "pattern": "^SPEC-[0-9]{4}$"},
    "title": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["draft", "approved", "superseded"]},
    "direction": {"type": "string", "enum": ["long_only"]},
    "sources": {"type": "object"},
    "candidate_pool": {"type": "object",
      "required": ["snapshot_window", "prefilter_prev_close", "gap_basis", "gap_min_pct_exclusive", "features_asof",
                   "news_asof_field", "suspect_split"],
      "properties": {"snapshot_window": {"$ref": "#/definitions/window"}, "prefilter_prev_close": {"$ref": "#/definitions/range"},
                     "gap_min_pct_exclusive": {"$ref": "#/definitions/pos"}, "features_asof": {"$ref": "#/definitions/hhmm"},
                     "suspect_split": {"type": "object", "required": ["common_ratio_tol", "min_ratio", "max_dollar_volume_surge", "lookback_sessions"]}}},
    "scanners": {"type": "object", "required": ["pre_market_gap", "high_of_day", "reversal_hybrid"],
      "properties": {
        "pre_market_gap": {"type": "object",
          "required": ["price_usd", "preferred_price_usd", "gap_min_pct_exclusive", "float_max_shares_exclusive",
                       "float_must_be_known", "pm_volume_min_shares", "rvol_min", "catalyst"],
          "properties": {"price_usd": {"$ref": "#/definitions/range"}, "preferred_price_usd": {"$ref": "#/definitions/range"},
                         "gap_min_pct_exclusive": {"$ref": "#/definitions/pos"}, "float_max_shares_exclusive": {"$ref": "#/definitions/pos"},
                         "float_must_be_known": {"type": "boolean"}, "pm_volume_min_shares": {"$ref": "#/definitions/pos"},
                         "rvol_min": {"$ref": "#/definitions/pos"},
                         "catalyst": {"type": "object", "required": ["required_any", "excluded", "non_qualifying"],
                           "properties": {"required_any": {"type": "array", "items": {"$ref": "#/definitions/catalyst"}, "minItems": 1},
                                          "excluded": {"type": "array", "items": {"$ref": "#/definitions/catalyst"}},
                                          "non_qualifying": {"type": "array", "items": {"$ref": "#/definitions/catalyst"}}}}}},
        "high_of_day": {"type": "object",
          "required": ["active_window", "price_usd", "volume_today_min_shares", "rvol_min", "volume_surge_5min_min_ratio",
                       "float_max_shares", "spread_max_usd", "requires_new_hod", "catalyst_required"],
          "properties": {"active_window": {"$ref": "#/definitions/window"}, "price_usd": {"$ref": "#/definitions/range"}}},
        "reversal_hybrid": {"type": "object",
          "required": ["active_window", "price_usd", "volume_today_min_shares", "adv5_min_shares", "rvol_min",
                       "consecutive_5m_candles_min", "bollinger", "rsi", "at_low_of_day", "target_ema9_5m_min_distance_usd"],
          "properties": {"active_window": {"$ref": "#/definitions/window"}, "price_usd": {"$ref": "#/definitions/range"},
                         "consecutive_5m_candles_min": {"type": "integer", "minimum": 1}}}}},
    "funnel": {"type": "object", "required": ["tier1_max", "tier2_max", "tier3_max", "weights", "subscores", "tier2_order", "tier3_rule"],
      "properties": {"tier1_max": {"type": "integer", "minimum": 1}, "tier2_max": {"type": "integer", "minimum": 1},
                     "tier3_max": {"type": "integer", "const": 1},
                     "weights": {"type": "object", "required": ["gap", "rvol", "low_float", "catalyst", "former_runner"],
                       "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "former_runner": {"type": "object", "required": ["lookback_sessions", "multi_day_window_sessions", "move_min_ratio"]},
    "chart_filters": {"type": "object", "required": ["daily_emas_above", "ema_min_bars", "window", "pm_consolidation"]},
    "patterns": {"type": "object", "required": ["bull_flag", "flat_top", "abcd", "breakout_volume", "pm_pattern"]},
    "entries": {"type": "object", "required": ["common", "GG-1", "GG-2", "GG-3", "GG-4", "MP-1", "REV-1"],
      "properties": {"GG-1": {"$ref": "#/definitions/entry"}, "GG-2": {"$ref": "#/definitions/entry"},
                     "GG-3": {"$ref": "#/definitions/entry"}, "GG-4": {"$ref": "#/definitions/entry"},
                     "MP-1": {"$ref": "#/definitions/entry"}, "REV-1": {"$ref": "#/definitions/entry"}}},
    "execution": {"type": "object",
      "required": ["gap_and_go_first_minute_volume_min", "momentum_volume_min", "spread_max_usd", "min_reward_risk",
                   "predetermined_entry_and_stop", "averaging_down", "slippage"],
      "properties": {"averaging_down": {"const": false}, "predetermined_entry_and_stop": {"const": true},
                     "min_reward_risk": {"type": "number", "minimum": 2.0}}},
    "exits": {"type": "object", "required": ["WT", "REV", "flatten_minutes_before_close"]},
    "risk": {"type": "object", "required": ["per_trade_risk_pct_of_equity", "account_sizes_usd", "cash_account_settlement",
                                            "max_consecutive_losers_per_day", "max_daily_loss_R", "max_attempts_per_stock_per_day"],
      "properties": {"per_trade_risk_pct_of_equity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.0}}},
    "tape": {"type": "object"},
    "routine": {"type": "object", "required": ["stages"]},
    "evaluation": {"type": "object", "required": ["sets", "trials", "global_trials_after", "dev_span", "oos_span", "holdout_span", "holdout_rule"],
      "properties": {"trials": {"type": "array", "minItems": 1, "uniqueItems": true}}},
    "not_implementable": {"type": "array", "items": {"type": "object", "required": ["id", "item", "reason"]}}
  }
}
