{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stocksdelta/options",
  "title": "Options levels edition (published by the after-close options levels run)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session",
    "tickers"
  ],
  "properties": {
    "schema": {
      "const": "stocksdelta/options"
    },
    "schema_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "session": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "built_from": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "tickers": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "from_bar": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "half_day": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "last": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "high",
              "low",
              "close"
            ],
            "properties": {
              "open": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "high": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "close": {
                "type": "number"
              }
            }
          },
          "atr14": {
            "type": [
              "number",
              "null"
            ]
          },
          "close_strength": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "pos": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "chip": {
                "enum": [
                  "STRONG",
                  "MID",
                  "WEAK",
                  null
                ]
              }
            }
          },
          "expected_move": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "annual_iv": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "iv_pct_52w": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "day": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "week": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              }
            }
          },
          "levels": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "price"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{2,8}$"
                },
                "price": {
                  "type": "number"
                },
                "tf": {
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "52w",
                    "ma",
                    "sd",
                    null
                  ]
                },
                "weight": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10
                },
                "lo": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "hi": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "zones": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lo",
                "hi",
                "side"
              ],
              "properties": {
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                },
                "weight": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 40
                },
                "members": {
                  "type": "array",
                  "maxItems": 24,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{2,8}$"
                  }
                },
                "side": {
                  "enum": [
                    "support",
                    "resistance"
                  ]
                },
                "big": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "bars": {
            "type": "array",
            "maxItems": 60,
            "description": "Recent daily bars, oldest first, for the level map.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "d",
                "o",
                "h",
                "l",
                "c"
              ],
              "properties": {
                "d": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "o": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                },
                "l": {
                  "type": "number"
                },
                "c": {
                  "type": "number"
                }
              }
            }
          },
          "problems": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "vol": {
            "description": "How the name's options are priced against its own past and its own movement. Volatilities are annualised fractions (0.24 is 24%), as expected_move.annual_iv is. New in version 2.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "iv30": {
                "description": "30-day implied vol as a fraction. The ceiling of 5 refuses a value sent as a percentage.",
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "iv_change_1d": {
                "description": "The day's change in iv30 as a fraction: 0.012 is 1.2 volatility points. The bounds refuse a value sent in points.",
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1,
                "maximum": 1
              },
              "iv_pct_13w": {
                "description": "Where iv30 sits in its own last 13 weeks, as a fraction.",
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "iv_pct_26w": {
                "description": "Where iv30 sits in its own last 26 weeks, as a fraction. The 52-week figure is expected_move.iv_pct_52w.",
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "hv30": {
                "description": "30-day realised vol as a fraction.",
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "opt_volume": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "opt_volume_avg20": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,40}$"
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "side": {
            "enum": [
              "call",
              "put",
              null
            ]
          },
          "status": {
            "enum": [
              "proven",
              "probation",
              "retired"
            ]
          },
          "since": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "backtest": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "avg_r": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ci_lo": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ci_hi": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "period": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              }
            }
          },
          "live": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "avg_r": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "wins": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "paper": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "symbol",
          "rule"
        ],
        "properties": {
          "session": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "rule": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,40}$"
          },
          "side": {
            "enum": [
              "call",
              "put",
              null
            ]
          },
          "entry": {
            "type": [
              "number",
              "null"
            ]
          },
          "stop": {
            "type": [
              "number",
              "null"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "exit": {
            "enum": [
              "target",
              "stop",
              "close",
              null
            ]
          },
          "r": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "expected_move_check": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "inside_1d_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "touch_5d_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "market": {
      "description": "The day itself, as of the close the edition was built from. New in version 2.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "vix": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "close": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "change": {
              "type": [
                "number",
                "null"
              ]
            },
            "pct_52w": {
              "description": "A fraction: 0.34 is the 34th percentile of the last year.",
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "session": {
          "description": "Whether the session the levels are for closes early. The site works the hours out from this alone.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "half_day": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "calendar": {
          "description": "Whether the macro rows in `events` are the whole calendar for the session and the week after it. Only 'complete' lets the page say a day has no scheduled release.",
          "enum": [
            "complete",
            "partial",
            null
          ]
        }
      }
    },
    "events": {
      "description": "Scheduled events near the session: macro releases (no symbol) and earnings (one symbol). Codes only, never headlines: the site names the codes it knows and shows any other as 'Other release'. New in version 2.",
      "type": [
        "array",
        "null"
      ],
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "type"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time_et": {
            "description": "New York time, 8:30 or 08:30, seconds allowed and ignored.",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "macro",
              "earnings"
            ]
          },
          "type": {
            "description": "A code such as cpi or fomc_decision. Never drawn as written.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low",
              null
            ]
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "when": {
            "description": "For earnings: bmo, amc or during. Another code is accepted and not drawn.",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{1,12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
