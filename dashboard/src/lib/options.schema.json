{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stocksdelta/options",
  "title": "Options levels edition (published by the after-close options levels run)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session",
    "tickers"
  ],
  "properties": {
    "schema": {
      "const": "stocksdelta/options"
    },
    "schema_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "session": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "built_from": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "tickers": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "from_bar": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "half_day": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "last": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "high",
              "low",
              "close"
            ],
            "properties": {
              "open": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "high": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "close": {
                "type": "number"
              }
            }
          },
          "atr14": {
            "type": [
              "number",
              "null"
            ]
          },
          "close_strength": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "pos": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "chip": {
                "enum": [
                  "STRONG",
                  "MID",
                  "WEAK",
                  null
                ]
              }
            }
          },
          "expected_move": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "annual_iv": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "iv_pct_52w": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "day": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "week": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              }
            }
          },
          "levels": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "price"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{2,8}$"
                },
                "price": {
                  "type": "number"
                },
                "tf": {
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "52w",
                    "ma",
                    "sd",
                    null
                  ]
                },
                "weight": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10
                },
                "lo": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "hi": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "zones": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lo",
                "hi",
                "side"
              ],
              "properties": {
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                },
                "weight": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 40
                },
                "members": {
                  "type": "array",
                  "maxItems": 24,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{2,8}$"
                  }
                },
                "side": {
                  "enum": [
                    "support",
                    "resistance"
                  ]
                },
                "big": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "problems": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,40}$"
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "side": {
            "enum": [
              "call",
              "put",
              null
            ]
          },
          "status": {
            "enum": [
              "proven",
              "probation",
              "retired"
            ]
          },
          "since": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "backtest": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "avg_r": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ci_lo": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ci_hi": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "period": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              }
            }
          },
          "live": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "avg_r": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "wins": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "paper": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "symbol",
          "rule"
        ],
        "properties": {
          "session": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "rule": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,40}$"
          },
          "side": {
            "enum": [
              "call",
              "put",
              null
            ]
          },
          "entry": {
            "type": [
              "number",
              "null"
            ]
          },
          "stop": {
            "type": [
              "number",
              "null"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "exit": {
            "enum": [
              "target",
              "stop",
              "close",
              null
            ]
          },
          "r": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "expected_move_check": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "inside_1d_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "touch_5d_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    }
  }
}
