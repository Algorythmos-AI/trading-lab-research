# Local development only. Real values live in Vercel project settings (production) and ~/trading/.env (publisher).
# Never commit real values.

# Serve the anonymized fixture instead of reading Blob storage.
DASHBOARD_FIXTURE=1

# Shared HMAC secret between the Mac publisher and /api/ingest.
DASHBOARD_INGEST_SECRET=
# Bearer token Vercel Cron sends to /api/cron/watchdog.
CRON_SECRET=
# ntfy topic for watchdog pages (secret, random). NTFY_SERVER defaults to https://ntfy.sh.
NTFY_TOPIC=
NTFY_SERVER=
# Added automatically when a private Blob store is connected to the project. Production only: previews
# run in fixture mode and never hold a token that could write production data.
BLOB_READ_WRITE_TOKEN=
